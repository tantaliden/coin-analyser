[Unit]
Description=Cross-Sectional Momentum Paper-Shadow (marktneutral, kein Echtgeld)
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/coin
ExecStart=/opt/coin/venv/bin/python3 -u /opt/coin/backend/gbm/cross_sectional_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
