[Unit]
Description=GBM-Predictor Live Paper-Shadow (regime-adaptiv, kein Echtgeld)
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/coin
ExecStart=/opt/coin/venv/bin/python3 -u /opt/coin/backend/gbm/gbm_shadow_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
